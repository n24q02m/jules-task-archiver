{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 120,
  "endOfLine": "lf",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "singleAttributePerLine": false,
  "overrides": [
    {
      "files": ["**/*.js"],
      "options": {
        "singleQuote": true,
        "jsxSingleQuote": false,
        "quoteProps": "as-needed",
        "trailingComma": "none",
        "semi": false,
        "arrowParens": "always"
      }
    }
  ],
  "ignorePatterns": ["**/*.md", "**/*.html"]
}
